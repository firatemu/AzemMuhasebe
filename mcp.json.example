{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/path/to/muhasebe"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://USER:PASSWORD@localhost:5436/muhasebe_db"
      ]
    },
    "git": {
      "command": "npx",
      "args": ["-y", "@cyanheads/git-mcp-server"],
      "env": {
        "GIT_BASE_DIR": "/path/to/muhasebe"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp"]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "mcp-fetch"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": "~/.config/cline/mcp-memory/memory.jsonl"
      }
    },
    "redis": {
      "command": "npx",
      "args": [
        "-y",
        "redis-mcp",
        "--redis-host",
        "localhost",
        "--redis-port",
        "6372"
      ]
    }
  }
}
